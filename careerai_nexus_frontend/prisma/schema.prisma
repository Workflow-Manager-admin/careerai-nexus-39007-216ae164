generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?  // Name from Google or profile (mirrored in 'profile' for enrich/extensibility)
  email         String   @unique
  emailVerified DateTime?
  image         String?
  provider      String   // e.g. 'google'
  password      String?  // For extensible auth (hash with bcrypt!)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          String   @default("user") // Support RBAC/min permissions
  /**
   * Extensible, onboarding / app profile data (enrichable).
   * Common fields include: { bio, avatar, location, headline, website, ... }
   * All providers/contributions merged here on each login.
   */
  profile       Json?
  // Audit and security
  lastLogin     DateTime?
  loginCount    Int      @default(0)
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String   @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? 
  access_token       String? 
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========== Additional Models for Dashboard Stats & Analytics ==========

model Interview {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  scheduledAt DateTime?    // When the interview happened or is scheduled
  score      Float?        // AI-assigned score/percent (0-100)
  transcript Json?         // Embedded array of Q&A and feedback
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Resume {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  title       String?  // Resume label/title
  docUrl      String?  // Storage location (optional)
  submissionCount Int   @default(0)    // Count of submissions using this resume
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Insight {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  weekStart  DateTime // Insights are grouped per week (ISO)
  summary    String   // AI-generated insight summary
  chartData  Json?    // Stored data points for charting (e.g. scores)
  createdAt  DateTime @default(now())
}

